# Copy to .env and fill in. .env is gitignored; never commit real tokens.
# Variables already set in your shell take precedence over this file.
#
# Both tokens come from the Apple Music web player:
#   1. Open https://music.apple.com in a browser and sign in.
#   2. Open DevTools (Cmd+Opt+I) and go to the Network tab.
#   3. Filter by "amp-api", then click around (e.g. open your Library)
#      so a request to amp-api.music.apple.com appears.
#   4. Select that request and look at its Request Headers.

# The "authorization" header, WITHOUT the "Bearer " prefix.
# A developer token Apple embeds in the web player; lasts months.
AM_DEV_TOKEN=

# The "media-user-token" header. Tied to your Apple ID session; expires
# when you sign out or after a while. If bootleg exits with code 2,
# refresh this one first.
AM_USER_TOKEN=

# Optional. Two-letter storefront (country) code, e.g. cz, us, gb.
# The -storefront flag overrides it. Defaults to "us".
AM_STOREFRONT=
